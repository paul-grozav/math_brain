#!/bin/bash
# Author: Tancredi-Paul Grozav <paul@grozav.info>
#
# docker run -it --name=math-brain-builder -v $(pwd):/mnt:rw debian:10.7
# apt update && apt-get install -y g++ make cmake nano git
#
(
echo -n "========================================"
echo "========================================"

echo "Started building process at "$(date +"%Y-%m-%d %H:%M:%S.%N")" ..."

[ -d bin ] && rm -Rf bin
mkdir bin &&
cd bin &&
cmake .. -DCMAKE_BUILD_TYPE:STRING=Debug &&
make &&
echo "Build finished. Here's your executable: bin/math_brain_app"

echo -n "========================================"
echo "========================================"
) 2>&1 | tee -a $0.log
