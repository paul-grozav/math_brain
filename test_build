#!/bin/bash
# Author: Tancredi-Paul Grozav <paul@grozav.info>
(
echo -n "========================================"
echo "========================================"

echo "Started testing build at "$(date +"%Y-%m-%d %H:%M:%S.%N")" ..."

echo "Testing..." ; echo 
status="All good!"
doxygen Doxygen.config > /dev/null

# ============================================================================ #
echo -n "* Unit Testing..."
if [ bin/math_brain_unit_testing ]; then
    echo " [  OK  ]"
else
    echo " [FAILED]"
    status="Not so good!"
fi

# ============================================================================ #
echo -n "* Doxygen warnings..."
if [ "$(cat Doxygen_warnings.log | wc -l)" == "0" ]; then
    echo " [  OK  ]"
else
    echo " [FAILED]"
    status="Not so good!"
fi

# ============================================================================ #
echo -n "* Source lines ending with space..."
if [ "$(grep -nir '\ $' src | awk -F':' 'function ltrim(s){
sub(/^[ \t\r\n]+/, "", s); return s }function rtrim(s) {
sub(/[ \t\r\n]+$/, "", s); return s }function trim(s) {return rtrim(ltrim(s)); }
{if(trim($3)!="") print $0;}' | wc -l)" == "0" ]; then
    echo " [  OK  ]"
else
    echo " [FAILED]"
    status="Not so good!"
fi

# ============================================================================ #
echo -n "* Source must not have TABs..."
if [ "$(grep -Pnir '\t' src | wc -l)" == "0" ]; then
    echo " [  OK  ]"
else
    echo " [FAILED]"
    status="Not so good!"
fi

# ============================================================================ #
echo -n "* Source lines > 80 characters..."
if [ "$(for f in $(find src -name *.cpp -or -name *.hpp); do cat $f | awk -v \
    file="$f" 'BEGIN{line_nr=1}{print length($0)" "line_nr" "file" "$0;
line_nr+=1}' | awk '{if( $1 > 80 ) print $0}'; done | wc -l)" == "0" ]; then
    echo " [  OK  ]"
else
    echo " [FAILED]"
    status="Not so good!"
fi

# ============================================================================ #
echo ; echo "Done testing build. $status"

echo -n "========================================"
echo "========================================"
) 2>&1 | tee -a $0.log
